    </div>
  </footer>

  <script>
    // ============================================================
    // STRIPE PAYMENT LINKS
    // Replace each placeholder below with your real Stripe link
    // ============================================================

    const STRIPE_LINKS = {
      "Studio / Small 1 Bedroom": https://buy.stripe.com/5kQ6oHaU3eO4azSbtC7Re01,
      "Standard 1 Bedroom": https://buy.stripe.com/5kQ3cvfajeO4bDWeFO7Re00,
      "2 Bedroom": https://buy.stripe.com/28E6oH5zJ5dugYg55e7Re03,
      "3 Bedroom": https://buy.stripe.com/5kQeVde6f9tK6jCgNW7Re04,
      "Large Homes": https://buy.stripe.com/cNi7sL3rBgWc4bu9lu7Re02
    };

    const basePackage = document.getElementById("basePackage");
    const singleToteAddon = document.getElementById("singleToteAddon");
    const addonTiming = document.getElementById("addonTiming");
    const checkoutBtn = document.getElementById("checkoutBtn");
    const agreeCheckbox = document.getElementById("agreeCheckbox");
    const bookingForm = document.getElementById("bookingForm");
    const errorBox = document.getElementById("errorBox");

    const summaryPackage = document.getElementById("summaryPackage");
    const summaryIncluded = document.getElementById("summaryIncluded");
    const summaryBasePrice = document.getElementById("summaryBasePrice");
    const summaryAddon = document.getElementById("summaryAddon");
    const summaryTotal = document.getElementById("summaryTotal");

    function money(value) {
      return `$${Number(value).toFixed(2)}`;
    }

    function updateSummary() {
      const pkgOption = basePackage.options[basePackage.selectedIndex];
      const addonOption = singleToteAddon.options[singleToteAddon.selectedIndex];

      const pkgPrice = Number(basePackage.value || 0);
      const pkgName = pkgOption?.dataset?.name || "Make selection below";
      const pkgTotes = pkgOption?.dataset?.totes || "0";

      const addonPrice = Number(singleToteAddon.value || 0);
      const addonLabel = addonOption?.dataset?.label || "No add-on";

      summaryPackage.textContent = pkgName;
      summaryIncluded.textContent = `${pkgTotes} totes included`;
      summaryBasePrice.textContent = money(pkgPrice);
      summaryAddon.textContent = addonLabel;
      summaryTotal.textContent = money(pkgPrice + addonPrice);
    }

    basePackage.addEventListener("change", updateSummary);
    singleToteAddon.addEventListener("change", updateSummary);
    addonTiming.addEventListener("change", updateSummary);

    function showError(message) {
      errorBox.textContent = message;
      errorBox.style.display = "block";
    }

    function clearError() {
      errorBox.textContent = "";
      errorBox.style.display = "none";
    }

    checkoutBtn.addEventListener("click", function () {
      clearError();

      if (!bookingForm.reportValidity()) {
        showError("Please complete all required booking details before proceeding to checkout.");
        return;
      }

      if (!agreeCheckbox.checked) {
        showError("Please review and accept the Service Agreement before proceeding to checkout.");
        agreeCheckbox.focus();
        return;
      }

      const selectedOption = basePackage.options[basePackage.selectedIndex];
      const packageName = selectedOption?.dataset?.name || "";
      const paymentLink = STRIPE_LINKS[packageName];

      if (!packageName) {
        showError("Please select a package before proceeding.");
        return;
      }

      if (!paymentLink || paymentLink.includes("PASTE_")) {
        showError("Please add the Stripe payment link for the selected package before going live.");
        return;
      }

      const formData = new FormData(bookingForm);
      const bookingData = Object.fromEntries(formData.entries());
      bookingData.basePackageName = packageName;
      bookingData.basePackageTotes = selectedOption?.dataset?.totes || "";
      bookingData.checkoutTotal = summaryTotal.textContent;
      bookingData.agreementAccepted = agreeCheckbox.checked ? "Yes" : "No";
      bookingData.agreementAcceptedAt = new Date().toISOString();

      try {
        localStorage.setItem("tmg_booking_data", JSON.stringify(bookingData));
      } catch (e) {
        // silent fail
      }

      window.location.href = paymentLink;
    });

    updateSummary();
  </script>
</body>
