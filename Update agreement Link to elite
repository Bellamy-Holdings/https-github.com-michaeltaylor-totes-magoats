  <script>
    const summaryPackage = document.getElementById("summaryPackage");
    const summaryTotes = document.getElementById("summaryTotes");
    const summaryPrice = document.getElementById("summaryPrice");
    const summaryAddon = document.getElementById("summaryAddon");
    const summaryTotal = document.getElementById("summaryTotal");
    const completeBookingBtn = document.getElementById("completeBookingBtn");
    const bookingForm = document.getElementById("bookingForm");
    const selectedPriceInput = document.getElementById("selectedPriceInput");
    const selectedPackageInput = document.getElementById("selectedPackageInput");
    const addonSummaryInput = document.getElementById("addonSummaryInput");
    const dwellingSelect = document.getElementById("dwelling");
    const addonTotesSelect = document.getElementById("addonTotes");
    const addonTimingSelect = document.getElementById("addonTiming");

    const packageMap = {
      "Studio / Small 1 Bedroom": {
        name: "Studio / Small 1 Bedroom",
        fit: "20 totes included",
        price: "$99",
        total: "$99 base checkout",
        link: "https://buy.stripe.com/5kQ6oHaU3eO4azSbtC7Re01"
      },
      "Standard 1 Bedroom": {
        name: "Standard 1 Bedroom",
        fit: "30 totes included",
        price: "$149",
        total: "$149 base checkout",
        link: "https://buy.stripe.com/5kQ3cvfajeO4bDWeFO7Re00"
      },
      "2 Bedroom": {
        name: "2 Bedroom",
        fit: "40 totes included",
        price: "$199",
        total: "$199 base checkout",
        link: "https://buy.stripe.com/28E6oH5zJ5dugYg55e7Re03"
      },
      "3 Bedroom": {
        name: "3 Bedroom",
        fit: "50 totes included",
        price: "$249",
        total: "$249 base checkout",
        link: "https://buy.stripe.com/5kQeVde6f9tK6jCgNW7Re04"
      },
      "Large Homes": {
        name: "Large Homes",
        fit: "75 totes included",
        price: "$300",
        total: "$300 base checkout",
        link: "https://buy.stripe.com/cNi7sL3rBgWc4bu9lu7Re02"
      }
    };

    const validSeattleZips = ["98101", "98104", "98121", "98154"];
    const validBellevueZips = ["98004"];

    function getSelectedPackageFromDropdown() {
      const value = dwellingSelect.value;
      if (!value) return null;
      return value.split(" — ")[0];
    }

    function getAddonSummary() {
      const count = addonTotesSelect.value;
      const timing = addonTimingSelect.value;

      if (count === "0") return "No add-on";

      const unitPrice = timing === "last-minute" ? 7 : 6;
      const total = Number(count) * unitPrice;
      return `${count} tote(s) requested • ${timing} • +$${total}`;
    }

    function updateBookingSummary() {
      const selectedPackage = getSelectedPackageFromDropdown();
      const addonSummary = getAddonSummary();

      if (!selectedPackage) {
        summaryPackage.textContent = "Make selection below";
        summaryTotes.textContent = "0 totes included";
        summaryPrice.textContent = "$0.00";
        summaryAddon.textContent = "No add-on";
        summaryTotal.textContent = "$0.00 base checkout";

        selectedPriceInput.value = "$0.00";
        selectedPackageInput.value = "Make selection below";
        addonSummaryInput.value = "No add-on";
        completeBookingBtn.disabled = true;
        return;
      }

      const data = packageMap[selectedPackage];
      if (!data) return;

      summaryPackage.textContent = data.name;
      summaryTotes.textContent = data.fit;
      summaryPrice.textContent = data.price;
      summaryAddon.textContent = addonSummary;
      summaryTotal.textContent = data.total;

      selectedPriceInput.value = data.price;
      selectedPackageInput.value = data.name;
      addonSummaryInput.value = addonSummary;
      completeBookingBtn.disabled = false;
    }

    function isValidZip(zip) {
      return /^\d{5}$/.test(zip);
    }

    function cityZipMatch(city, zip) {
      if (city === "Seattle") return validSeattleZips.includes(zip);
      if (city === "Bellevue") return validBellevueZips.includes(zip);
      return false;
    }

    dwellingSelect.addEventListener("change", updateBookingSummary);
    addonTotesSelect.addEventListener("change", updateBookingSummary);
    addonTimingSelect.addEventListener("change", updateBookingSummary);

    completeBookingBtn.addEventListener("click", function () {
      if (!bookingForm.checkValidity()) {
        bookingForm.reportValidity();
        return;
      }

      const selectedPackage = getSelectedPackageFromDropdown();
      if (!selectedPackage) {
        alert("Please select a base package before continuing.");
        return;
      }

      const fromCity = document.getElementById("fromCity").value;
      const toCity = document.getElementById("toCity").value;
      const fromZip = document.getElementById("fromZip").value.trim();
      const toZip = document.getElementById("toZip").value.trim();

      if (!isValidZip(fromZip) || !isValidZip(toZip)) {
        alert("Please enter valid 5-digit ZIP codes for both addresses.");
        return;
      }

      if (!cityZipMatch(fromCity, fromZip) || !cityZipMatch(toCity, toZip)) {
        alert("At this time, Totes Ma'Goats is only servicing Downtown Seattle and Downtown Bellevue. Please review the city and ZIP code for both addresses.");
        return;
      }

      const data = packageMap[selectedPackage];

      fetch(bookingForm.action, {
        method: "POST",
        body: new FormData(bookingForm),
        headers: { "Accept": "application/json" }
      }).finally(() => {
        window.location.href = data.link;
      });
    });

    updateBookingSummary();
  </script>
