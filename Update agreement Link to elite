<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Totes Ma'Goats | Downtown Seattle + Downtown Bellevue</title>
  <meta
    name="description"
    content="Reusable moving tote delivery for Downtown Seattle and Downtown Bellevue. Cleaner, smarter, easier moves for elevator-served buildings."
  />
  <style>
    :root {
      --bg: #f6f1e8;
      --card: #fffdf9;
      --ink: #1f2d2f;
      --muted: #6c6f6a;
      --line: #d8cec0;
      --brand: #d85a2a;
      --brand-dark: #b8441b;
      --forest: #315c46;
      --shadow: 0 14px 40px rgba(31, 45, 47, 0.08);
      --radius: 18px;
      --max: 1180px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      color: var(--ink);
      background:
        radial-gradient(circle at top right, rgba(216, 90, 42, 0.08), transparent 24%),
        linear-gradient(180deg, #f8f4ed 0%, #f4eee4 100%);
      line-height: 1.55;
    }

    a {
      color: inherit;
    }

    img {
      max-width: 100%;
      display: block;
    }

    .container {
      width: min(var(--max), calc(100% - 32px));
      margin: 0 auto;
    }

    .topbar {
      background: #203831;
      color: #f7f1e7;
      text-align: center;
      padding: 12px 16px;
      font-size: 0.95rem;
      letter-spacing: 0.04em;
    }

    .hero {
      padding: 40px 0 28px;
    }

    .hero-shell {
      background: linear-gradient(135deg, rgba(255,255,255,0.85), rgba(255,250,244,0.94));
      border: 1px solid rgba(216, 206, 192, 0.8);
      border-radius: 28px;
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 0;
      align-items: stretch;
    }

    .hero-copy {
      padding: 54px 48px;
    }

    .eyebrow {
      font-size: 0.88rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--forest);
      margin-bottom: 14px;
      font-weight: 700;
    }

    h1, h2, h3, h4 {
      margin: 0 0 12px;
      line-height: 1.15;
    }

    h1 {
      font-size: clamp(2.5rem, 5vw, 4.3rem);
      letter-spacing: -0.03em;
    }

    .hero-copy h2 {
      font-size: clamp(1.15rem, 2.2vw, 1.65rem);
      color: var(--forest);
      margin-bottom: 18px;
    }

    .hero-copy p {
      font-size: 1.1rem;
      max-width: 58ch;
      margin-bottom: 18px;
    }

    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 26px;
      margin-bottom: 18px;
    }

    .btn {
      appearance: none;
      border: none;
      border-radius: 999px;
      padding: 14px 22px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.18s ease, background 0.18s ease, opacity 0.18s ease;
    }

    .btn:hover {
      transform: translateY(-1px);
    }

    .btn-primary {
      background: var(--brand);
      color: #fff;
    }

    .btn-primary:hover {
      background: var(--brand-dark);
    }

    .btn-secondary {
      background: #fff;
      color: var(--ink);
      border: 1px solid var(--line);
    }

    .microcopy {
      color: var(--muted);
      font-size: 0.95rem;
    }

    .hero-visual {
      min-height: 100%;
      background:
        linear-gradient(180deg, rgba(49, 92, 70, 0.10), rgba(49, 92, 70, 0.04)),
        linear-gradient(140deg, #efe3d1 0%, #f8f3ea 100%);
      padding: 38px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .hero-card {
      width: 100%;
      max-width: 460px;
      background: rgba(255,255,255,0.88);
      border: 1px solid rgba(216, 206, 192, 0.9);
      border-radius: 24px;
      padding: 26px;
      box-shadow: var(--shadow);
    }

    .hero-card .logo-wrap {
      margin-bottom: 18px;
    }

    .hero-quote {
      font-size: 1.2rem;
      font-style: italic;
      margin-bottom: 6px;
      color: var(--forest);
    }

    .hero-signoff {
      color: var(--muted);
      margin-bottom: 16px;
    }

    .hero-points {
      display: grid;
      gap: 12px;
    }

    .hero-point {
      background: #fff;
      border: 1px solid #ebe2d6;
      border-radius: 14px;
      padding: 12px 14px;
      font-size: 0.98rem;
    }

    section {
      padding: 26px 0;
    }

    .section-head {
      margin-bottom: 20px;
    }

    .section-head h2 {
      font-size: clamp(1.8rem, 3vw, 2.5rem);
      margin-bottom: 8px;
    }

    .section-head p {
      margin: 0;
      color: var(--muted);
      max-width: 70ch;
    }

    .card-grid-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 22px;
    }

    .card h3 {
      font-size: 1.25rem;
      margin-bottom: 10px;
    }

    .card p {
      margin: 0;
      color: #324041;
    }

    .packages {
      display: grid;
      gap: 14px;
    }

    .package-row {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 14px;
      align-items: center;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 16px 18px;
      box-shadow: var(--shadow);
    }

    .package-row strong {
      display: block;
      font-size: 1.05rem;
    }

    .package-row span {
      color: var(--muted);
      font-size: 0.95rem;
    }

    .subtle-note {
      margin-top: 14px;
      color: var(--muted);
      font-size: 0.95rem;
    }

    .corridor {
      background: linear-gradient(180deg, rgba(255,255,255,0.74), rgba(255,255,255,0.92));
      border-radius: 24px;
      border: 1px solid var(--line);
      box-shadow: var(--shadow);
      padding: 24px;
    }

    .corridor-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 14px;
    }

    .tag {
      padding: 10px 14px;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 999px;
      font-weight: 700;
    }

    .booking-shell {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 22px;
      align-items: start;
    }

    .booking-card,
    .summary-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 24px;
      box-shadow: var(--shadow);
    }

    .booking-card {
      padding: 26px;
    }

    .summary-card {
      padding: 24px;
      position: sticky;
      top: 22px;
    }

    .mini-label {
      display: inline-block;
      margin-bottom: 8px;
      color: var(--forest);
      text-transform: uppercase;
      letter-spacing: 0.14em;
      font-size: 0.78rem;
      font-weight: 700;
    }

    form {
      display: grid;
      gap: 18px;
    }

    .field-grid-2,
    .field-grid-3 {
      display: grid;
      gap: 14px;
    }

    .field-grid-2 {
      grid-template-columns: repeat(2, 1fr);
    }

    .field-grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }

    .field-group {
      display: grid;
      gap: 8px;
    }

    label {
      font-weight: 700;
      font-size: 0.96rem;
    }

    input,
    select,
    textarea {
      width: 100%;
      border: 1px solid #cfc3b3;
      border-radius: 12px;
      padding: 14px 14px;
      font: inherit;
      background: #fff;
      color: var(--ink);
    }

    textarea {
      min-height: 110px;
      resize: vertical;
    }

    input:focus,
    select:focus,
    textarea:focus {
      outline: 2px solid rgba(216, 90, 42, 0.20);
      border-color: var(--brand);
    }

    .address-block {
      border: 1px solid #e4d9cd;
      border-radius: 18px;
      padding: 18px;
      background: #fffcf8;
    }

    .address-block h4 {
      margin-bottom: 12px;
      font-size: 1.1rem;
    }

    .booking-helper {
      color: var(--muted);
      font-size: 0.95rem;
      margin-top: -4px;
    }

    .agreement-section {
      margin-top: 6px;
      background: #f9f3ea;
      border: 1px solid #e3d7c7;
      border-radius: 18px;
      padding: 20px;
    }

    .agreement-section h3 {
      margin-bottom: 10px;
      font-size: 1.2rem;
    }

    .agreement-copy {
      margin: 0 0 14px;
      color: var(--ink);
    }

    .agreement-link {
      color: var(--brand) !important;
      font-weight: 700 !important;
      text-decoration: underline !important;
      text-underline-offset: 3px;
    }

    .agreement-link:hover {
      color: var(--brand-dark) !important;
    }

    .agreement-box {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      background: #fff;
      border: 1px solid #e2d4c2;
      border-radius: 14px;
      padding: 14px;
    }

    .agreement-box input[type="checkbox"] {
      width: 18px;
      height: 18px;
      margin-top: 3px;
      accent-color: var(--brand);
      flex: 0 0 auto;
    }

    .agreement-box label {
      font-weight: 400;
      font-size: 0.98rem;
      line-height: 1.45;
    }

    .agreement-note {
      margin: 10px 0 0;
      font-size: 0.92rem;
      color: var(--muted);
    }

    .summary-card h3 {
      margin-bottom: 14px;
      font-size: 1.5rem;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding: 10px 0;
      border-bottom: 1px solid #ece2d7;
      font-size: 0.98rem;
    }

    .summary-row:last-of-type {
      border-bottom: none;
    }

    .summary-total {
      margin-top: 10px;
      padding-top: 14px;
      border-top: 2px solid #e6d9ca;
      display: flex;
      justify-content: space-between;
      font-size: 1.1rem;
      font-weight: 700;
    }

    .summary-checks {
      margin: 18px 0 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 8px;
      color: #324041;
    }

    .summary-checks li::before {
      content: "✔";
      color: var(--forest);
      margin-right: 10px;
      font-weight: 700;
    }

    .checkout-note {
      margin-top: 16px;
      color: var(--muted);
      font-size: 0.94rem;
    }

    .secure-btn {
      width: 100%;
      margin-top: 18px;
      padding: 16px 20px;
      border-radius: 14px;
      font-size: 1.04rem;
    }

    .error-box {
      display: none;
      margin-top: 14px;
      background: #fff1ec;
      border: 1px solid #efc4b3;
      color: #8a3416;
      border-radius: 12px;
      padding: 12px 14px;
      font-size: 0.95rem;
    }

    .footer {
      padding: 30px 0 46px;
      color: var(--muted);
      text-align: center;
      font-size: 0.95rem;
    }

    @media (max-width: 980px) {
      .hero-grid,
      .booking-shell,
      .card-grid-3 {
        grid-template-columns: 1fr;
      }

      .field-grid-2,
      .field-grid-3,
      .package-row {
        grid-template-columns: 1fr;
      }

      .summary-card {
        position: static;
      }

      .hero-copy,
      .hero-visual {
        padding: 30px 24px;
      }
    }

    @media (max-width: 640px) {
      .container {
        width: min(var(--max), calc(100% - 20px));
      }

      .booking-card,
      .summary-card,
      .card,
      .corridor {
        border-radius: 18px;
      }

      .btn {
        width: 100%;
      }

      .cta-row {
        flex-direction: column;
      }
    }
  </style>
</head>
<body>
  <div class="topbar">DOWNTOWN SEATTLE + DOWNTOWN BELLEVUE DELIVERY</div>

  <header class="hero">
    <div class="container">
      <div class="hero-shell">
        <div class="hero-grid">
          <div class="hero-copy">
            <div class="eyebrow">Premium reusable moving tote service</div>
            <h1>Totes Ma'Goats</h1>
            <h2>The G.O.A.T. of Moving Totes</h2>
            <p>
              There’s a better way to move. No broken boxes. No wasted cardboard.
              No late-night tape runs. Just strong, stackable reusable totes
              designed for cleaner, easier moves between Downtown Seattle and
              Downtown Bellevue.
            </p>
            <p>
              Cleaner. Smarter. Easier. The way moving should have always been.
            </p>

            <div class="cta-row">
              <a class="btn btn-primary" href="#booking">Reserve Your Move Date</a>
              <a class="btn btn-secondary" href="#how-it-works">How It Works</a>
            </div>

            <div class="microcopy">
              Serving Downtown Seattle &amp; Downtown Bellevue only • Limited daily inventory
            </div>
          </div>

          <div class="hero-visual">
            <div class="hero-card">
              <div class="logo-wrap">
                <img src="/logo.png" alt="Totes Ma'Goats logo" onerror="this.style.display='none';" />
              </div>
              <div class="hero-quote">“Save the trees. Move with ease!”</div>
              <div class="hero-signoff">— Ma'Goats</div>

              <div class="hero-points">
                <div class="hero-point">Built for high-rise, elevator-served, and premium urban moves</div>
                <div class="hero-point">Reusable commercial-grade totes that stack cleanly and move beautifully</div>
                <div class="hero-point">Focused service corridor for tighter scheduling and better delivery reliability</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <section id="how-it-works">
    <div class="container">
      <div class="section-head">
        <h2>How It Works</h2>
        <p>
          Designed for busy renters and elevator-served buildings who want a cleaner,
          easier, more organized move inside the Downtown Seattle and Downtown Bellevue corridor.
        </p>
      </div>

      <div class="card-grid-3">
        <div class="card">
          <h3>1. Reserve</h3>
          <p>Choose your move size, enter your move details, and secure your reservation online.</p>
        </div>
        <div class="card">
          <h3>2. Pack</h3>
          <p>Use durable totes that stack neatly, protect your items, and simplify move day.</p>
        </div>
        <div class="card">
          <h3>3. Return</h3>
          <p>When the move is complete, we collect them. No cardboard pile. No cleanup required.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="packages">
    <div class="container">
      <div class="section-head">
        <h2>How Many Totes Do I Need?</h2>
        <p>
          Each package includes a fixed number of totes. The suggested range below is there to help
          you decide whether you may want to request additional add-on totes depending on how much you need to pack.
        </p>
      </div>

      <div class="packages">
        <div class="package-row">
          <div><strong>Studio / Small 1 Bedroom</strong><span>Best for lighter urban moves</span></div>
          <div><strong>20 totes</strong><span>Included</span></div>
          <div><strong>$99</strong><span>Base price</span></div>
          <div><strong>20–25 totes*</strong><span>Suggested range</span></div>
        </div>

        <div class="package-row">
          <div><strong>Standard 1 Bedroom</strong><span>Most common package</span></div>
          <div><strong>30 totes</strong><span>Included</span></div>
          <div><strong>$149</strong><span>Base price</span></div>
          <div><strong>25–35 totes*</strong><span>Suggested range</span></div>
        </div>

        <div class="package-row">
          <div><strong>2 Bedroom</strong><span>For fuller apartment moves</span></div>
          <div><strong>40 totes</strong><span>Included</span></div>
          <div><strong>$199</strong><span>Base price</span></div>
          <div><strong>35–45 totes*</strong><span>Suggested range</span></div>
        </div>

        <div class="package-row">
          <div><strong>3 Bedroom</strong><span>For larger household moves</span></div>
          <div><strong>50 totes</strong><span>Included</span></div>
          <div><strong>$249</strong><span>Base price</span></div>
          <div><strong>45–60 totes*</strong><span>Suggested range</span></div>
        </div>

        <div class="package-row">
          <div><strong>Large Homes</strong><span>For major pack-outs and larger moves</span></div>
          <div><strong>75 totes</strong><span>Included</span></div>
          <div><strong>$300</strong><span>Base price</span></div>
          <div><strong>60+ totes*</strong><span>Suggested range</span></div>
        </div>
      </div>

      <div class="subtle-note">
        *Suggested ranges are estimates only and may vary depending on how much you need to pack.
        Single totes are available only as add-ons after selecting one of the packages above.
      </div>
    </div>
  </section>

  <section id="why">
    <div class="container">
      <div class="section-head">
        <h2>Why Totes Ma'Goats?</h2>
      </div>

      <div class="card-grid-3">
        <div class="card">
          <h3>Eco-Friendly</h3>
          <p>No cardboard waste. Reusable totes make moving cleaner, greener, and smarter.</p>
        </div>
        <div class="card">
          <h3>Stronger</h3>
          <p>Commercial-grade totes hold up better than flimsy boxes and stack beautifully for elevator-friendly moves.</p>
        </div>
        <div class="card">
          <h3>Convenient</h3>
          <p>Delivered and collected within a focused service corridor — ideal for busy professionals and urban moves.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="elevator">
    <div class="container">
      <div class="section-head">
        <h2>Elevator-Friendly Service</h2>
        <p>
          Built for modern apartment living, mid-rise communities, and elevator-managed moves in Downtown Seattle and Downtown Bellevue.
        </p>
      </div>

      <div class="card-grid-3">
        <div class="card">
          <h3>Concierge-Aware Delivery</h3>
          <p>We understand that many buildings require front desk coordination, entry procedures, or specific delivery instructions.</p>
        </div>
        <div class="card">
          <h3>Loading Dock Ready</h3>
          <p>If your building has a loading dock or service entrance, include those details at booking so delivery goes smoothly and on time.</p>
        </div>
        <div class="card">
          <h3>Elevator Reservation Friendly</h3>
          <p>Need us to work around a reserved freight elevator or move-in window? Add that information in your booking notes and we’ll plan accordingly.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="corridor">
    <div class="container">
      <div class="corridor">
        <div class="section-head">
          <h2>Primary Delivery Corridor</h2>
          <p>
            We currently serve Downtown Seattle and Downtown Bellevue exclusively.
            This focused service area allows us to provide faster delivery, tighter scheduling,
            and a more reliable, high-touch experience for residents in these buildings.
          </p>
        </div>

        <div class="corridor-tags">
          <div class="tag">Downtown Seattle</div>
          <div class="tag">Downtown Bellevue</div>
        </div>
      </div>
    </div>
  </section>

  <section id="booking">
    <div class="container">
      <div class="section-head">
        <h2>Reserve Your Move Date</h2>
        <p>Choose your package, tell us about your move, and continue to secure your booking.</p>
      </div>

      <div class="booking-shell">
        <div class="booking-card">
          <span class="mini-label">Booking Request</span>
          <h3>Booking Details</h3>
          <p class="booking-helper">
            Start by selecting your base package below. Single totes are available only as add-ons
            after you choose one of the main move packages.
          </p>

          <form id="bookingForm">
            <div class="field-grid-2">
              <div class="field-group">
                <label for="fullName">Full Name</label>
                <input id="fullName" name="fullName" type="text" required />
              </div>
              <div class="field-group">
                <label for="phoneNumber">Phone Number</label>
                <input id="phoneNumber" name="phoneNumber" type="tel" required />
              </div>
            </div>

            <div class="field-grid-2">
              <div class="field-group">
                <label for="emailAddress">Email Address</label>
                <input id="emailAddress" name="emailAddress" type="email" required />
              </div>
              <div class="field-group">
                <label for="moveDate">Move Date</label>
                <input id="moveDate" name="moveDate" type="date" required />
              </div>
            </div>

            <div class="address-block">
              <h4>Moving From</h4>
              <div class="field-grid-2">
                <div class="field-group">
                  <label for="fromStreet">Street Address</label>
                  <input id="fromStreet" name="fromStreet" type="text" required />
                </div>
                <div class="field-group">
                  <label for="fromUnit">Apt / Unit</label>
                  <input id="fromUnit" name="fromUnit" type="text" />
                </div>
              </div>
              <div class="field-grid-3">
                <div class="field-group">
                  <label for="fromCity">City</label>
                  <select id="fromCity" name="fromCity" required>
                    <option value="">Select city</option>
                    <option value="Seattle">Seattle</option>
                    <option value="Bellevue">Bellevue</option>
                  </select>
                </div>
                <div class="field-group">
                  <label for="fromState">State</label>
                  <input id="fromState" name="fromState" type="text" value="WA" required />
                </div>
                <div class="field-group">
                  <label for="fromZip">ZIP Code</label>
                  <input id="fromZip" name="fromZip" type="text" required />
                </div>
              </div>
            </div>

            <div class="address-block">
              <h4>Moving To</h4>
              <div class="field-grid-2">
                <div class="field-group">
                  <label for="toStreet">Street Address</label>
                  <input id="toStreet" name="toStreet" type="text" required />
                </div>
                <div class="field-group">
                  <label for="toUnit">Apt / Unit</label>
                  <input id="toUnit" name="toUnit" type="text" />
                </div>
              </div>
              <div class="field-grid-3">
                <div class="field-group">
                  <label for="toCity">City</label>
                  <select id="toCity" name="toCity" required>
                    <option value="">Select city</option>
