<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Totes Ma'Goats | Downtown Seattle + Downtown Bellevue</title>

  <style>
    :root {
      --cream: #efe6d6;
      --cream-light: #f7f1e4;
      --green: #274d2f;
      --green-dark: #1a2a1a;
      --text: #2f3e2f;
      --orange: #d3542a;
      --orange-dark: #b8431f;
      --white: #ffffff;
      --border: rgba(39, 77, 47, 0.12);
      --shadow: 0 10px 28px rgba(0, 0, 0, 0.08);
      --shadow-soft: 0 4px 14px rgba(0, 0, 0, 0.06);
      --radius: 18px;
      --disabled: #c8bfb1;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: Georgia, serif;
      background: var(--cream);
      color: var(--text);
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    img {
      max-width: 100%;
      display: block;
    }

    .container {
      width: min(1200px, 90%);
      margin: 0 auto;
    }

    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding: 0 8%;
      background-image: url("hero-seattle.png");
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      overflow: hidden;
    }

    .hero::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 28% 45%, rgba(255,248,230,0.85) 0%, rgba(255,248,230,0.62) 35%, rgba(255,248,230,0.20) 68%, rgba(255,248,230,0.04) 100%);
      z-index: 1;
    }

    .hero-grid {
      position: relative;
      z-index: 2;
      width: 100%;
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 40px;
      align-items: center;
    }

    .hero-content {
      max-width: 760px;
      text-shadow: 0 2px 8px rgba(255,255,255,0.35);
    }

    .badge {
      display: inline-block;
      background: rgba(39,77,47,0.10);
      padding: 10px 18px;
      border-radius: 999px;
      font-size: 15px;
      letter-spacing: 1px;
      margin-bottom: 24px;
    }

    .hero-content h1 {
      font-size: 96px;
      line-height: 0.98;
      margin: 0 0 12px 0;
      color: var(--green-dark);
    }

    .hero-content h2 {
      font-size: 36px;
      margin: 0 0 16px 0;
      color: var(--green-dark);
      font-weight: normal;
    }

    .hero-content p {
      font-size: 23px;
      line-height: 1.6;
      margin: 0 0 16px 0;
    }

    .hero-cta-row {
      margin-top: 28px;
    }

    .cta-button {
      display: inline-block;
      background: var(--orange);
      color: var(--white);
      padding: 22px 42px;
      border-radius: 12px;
      font-weight: bold;
      font-size: 20px;
      letter-spacing: 0.4px;
      box-shadow: 0 12px 24px rgba(211,84,42,0.28);
      transition: all 0.25s ease;
    }

    .cta-button:hover {
      background: var(--orange-dark);
      transform: translateY(-2px);
      box-shadow: 0 16px 30px rgba(211,84,42,0.35);
    }

    .hero-subnote {
      font-size: 16px !important;
      margin-top: 12px !important;
    }

    .hero-brand {
      justify-self: end;
      text-align: center;
    }

    .hero-brand img {
      width: min(520px, 100%);
      filter: drop-shadow(0 12px 24px rgba(0,0,0,0.14));
    }

    .quote {
      margin-top: 14px;
      font-size: 16px;
      font-style: italic;
      text-shadow: 0 2px 8px rgba(255,255,255,0.35);
    }

    .brand-strip {
      background: var(--green);
      color: var(--white);
      text-align: center;
      padding: 16px 20px;
      font-size: 18px;
      font-weight: 600;
    }

    .section {
      padding: 82px 0;
    }

    .section.alt {
      background: var(--cream-light);
    }

    .section h2 {
      margin: 0 0 14px 0;
      font-size: 42px;
      color: var(--green-dark);
      text-align: center;
    }

    .section-intro {
      max-width: 920px;
      margin: 0 auto 28px auto;
      font-size: 20px;
      line-height: 1.8;
      text-align: center;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-top: 34px;
    }

    .card {
      background: var(--white);
      border-radius: var(--radius);
      padding: 28px;
      box-shadow: var(--shadow-soft);
    }

    .card h3 {
      margin: 0 0 12px 0;
      font-size: 28px;
      color: var(--green-dark);
    }

    .card p {
      margin: 0;
      font-size: 17px;
      line-height: 1.68;
    }

    .guide-list {
      max-width: 1040px;
      margin: 36px auto 0 auto;
      background: var(--white);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .guide-row {
      display: grid;
      grid-template-columns: 1.6fr 1fr 0.8fr 1.1fr;
      gap: 16px;
      align-items: center;
      padding: 18px 24px;
      border-bottom: 1px solid var(--border);
    }

    .guide-row:last-child {
      border-bottom: none;
    }

    .guide-head {
      background: rgba(239,230,214,0.55);
      font-weight: bold;
      color: var(--green-dark);
    }

    .guide-left {
      font-weight: bold;
      color: var(--green-dark);
    }

    .guide-muted {
      font-size: 15px;
      opacity: 0.92;
    }

    .guide-price {
      font-weight: bold;
      color: var(--orange-dark);
    }

    .micro-note {
      max-width: 920px;
      margin: 18px auto 0 auto;
      font-size: 15px;
      line-height: 1.7;
      text-align: center;
      opacity: 0.85;
    }

    .service-pills {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
      margin-top: 28px;
    }

    .pill {
      padding: 10px 16px;
      background: var(--white);
      border-radius: 999px;
      box-shadow: var(--shadow-soft);
      border: 1px solid var(--border);
    }

    .booking-wrap {
      max-width: 1140px;
      margin: 0 auto;
      background: var(--cream-light);
      border-radius: 22px;
      padding: 36px;
      box-shadow: var(--shadow);
    }

    .booking-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 28px;
      align-items: start;
    }

    .booking-form,
    .booking-summary {
      background: var(--white);
      border-radius: 18px;
      padding: 28px;
      border: 1px solid var(--border);
    }

    .booking-form h3,
    .booking-summary h3 {
      margin: 0 0 18px 0;
      font-size: 30px;
      color: var(--green-dark);
    }

    .booking-label {
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: rgba(47,62,47,0.7);
      margin-bottom: 14px;
      font-weight: bold;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 16px;
    }

    .form-row.three {
      grid-template-columns: 1.2fr 0.8fr 1fr;
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-group label {
      display: block;
      font-weight: bold;
      margin-bottom: 8px;
      color: var(--green-dark);
      font-size: 16px;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      padding: 15px 16px;
      border: 1px solid rgba(39,77,47,0.18);
      border-radius: 12px;
      font-size: 16px;
      font-family: Georgia, serif;
      background: var(--white);
      color: var(--text);
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: rgba(211,84,42,0.5);
      box-shadow: 0 0 0 3px rgba(211,84,42,0.10);
    }

    .form-group input[readonly] {
      background: #f4f0e6;
    }

    .form-group textarea {
      min-height: 120px;
      resize: vertical;
    }

    .address-block {
      background: rgba(239,230,214,0.45);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 18px;
      margin-bottom: 18px;
    }

    .address-title {
      margin: 0 0 14px 0;
      font-size: 20px;
      font-weight: bold;
      color: var(--green-dark);
    }

    .package-helper {
      background: rgba(211,84,42,0.07);
      border: 1px solid rgba(211,84,42,0.18);
      border-radius: 14px;
      padding: 14px 16px;
      margin-bottom: 18px;
      font-size: 15px;
      line-height: 1.7;
    }

    .zone-note {
      font-size: 14px;
      line-height: 1.7;
      margin: -2px 0 18px 0;
      color: rgba(47,62,47,0.85);
    }

    .summary-box {
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 18px 0;
      margin: 18px 0;
    }

    .summary-line {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 12px;
      font-size: 17px;
    }

    .summary-line:last-child {
      margin-bottom: 0;
    }

    .summary-line span:last-child,
    .summary-line strong:last-child {
      text-align: right;
    }

    .summary-total {
      margin-top: 14px;
      font-size: 24px;
      font-weight: bold;
      color: var(--orange);
    }

    .payment-buttons {
      margin-top: 22px;
    }

    .pay-btn {
      display: block;
      width: 100%;
      text-align: center;
      padding: 18px 20px;
      border-radius: 12px;
      font-weight: bold;
      font-size: 18px;
      border: none;
      transition: all 0.25s ease;
    }

    .pay-btn.primary {
      background: var(--orange);
      color: var(--white);
      cursor: pointer;
      box-shadow: 0 10px 22px rgba(211,84,42,0.25);
    }

    .pay-btn.primary:hover:not(:disabled) {
      background: var(--orange-dark);
      transform: translateY(-2px);
    }

    .pay-btn:disabled {
      background: var(--disabled);
      color: rgba(255,255,255,0.9);
      cursor: not-allowed;
      box-shadow: none;
      transform: none;
    }

    .trust-list {
      margin-top: 18px;
      padding: 16px 18px;
      border-radius: 14px;
      background: rgba(39,77,47,0.05);
      border: 1px solid var(--border);
    }

    .trust-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 15px;
      line-height: 1.6;
      margin-bottom: 8px;
    }

    .trust-item:last-child {
      margin-bottom: 0;
    }

    .trust-check {
      color: var(--green);
      font-weight: bold;
      margin-top: 1px;
    }

    .small-note {
      font-size: 14px;
      line-height: 1.7;
      color: rgba(47,62,47,0.82);
      margin-top: 14px;
    }

    .footer {
      background: var(--green);
      color: var(--white);
      text-align: center;
      padding: 30px 20px;
      line-height: 1.8;
    }

    @media (max-width: 980px) {
      .hero {
        display: block;
        min-height: auto;
        padding: 80px 8%;
      }

      .hero-grid,
      .cards,
      .booking-grid,
      .guide-row,
      .form-row,
      .form-row.three {
        grid-template-columns: 1fr;
      }

      .hero-brand {
        justify-self: center;
        margin-top: 24px;
      }
    }

    @media (max-width: 600px) {
      .hero-content h1 {
        font-size: 54px;
      }

      .hero-content h2 {
        font-size: 24px;
      }

      .hero-content p {
        font-size: 18px;
      }

      .cta-button {
        padding: 18px 28px;
        font-size: 18px;
      }

      .booking-wrap {
        padding: 22px;
      }

.agreement-copy {
  color: #1f2d2f;
  line-height: 1.5;
}

.agreement-link,
.agreement-copy .agreement-link,
.agreement-section .agreement-link {
  color: #d3542c !important;
  font-weight: 700 !important;
  text-decoration: underline !important;
  text-underline-offset: 3px;
}

.agreement-link:hover,
.agreement-copy .agreement-link:hover,
.agreement-section .agreement-link:hover {
  color: #b8431f !important;
}
    }
  </style>
</head>
<body>

  <section class="hero">
    <div class="hero-grid">
      <div class="hero-content">
        <div class="badge">DOWNTOWN SEATTLE + DOWNTOWN BELLEVUE DELIVERY</div>

        <h1>Totes Ma'Goats</h1>
        <h2>The G.O.A.T. of Moving Totes</h2>

        <p><strong>There’s a better way to move.</strong></p>
        <p>No broken boxes. No wasted cardboard. No late-night tape runs. Just strong, stackable reusable totes designed for cleaner, easier moves between Downtown Seattle and Downtown Bellevue.</p>
        <p>Cleaner. Smarter. Easier. The way moving should have always been.</p>

        <div class="hero-cta-row">
          <a href="#booking" class="cta-button">Reserve Your Move Date</a>
        </div>

        <p class="hero-subnote">Serving Downtown Seattle & Downtown Bellevue only • Limited daily inventory</p>
        <p class="hero-subnote" style="margin-top:2px !important;">Service limited to this corridor to ensure fast, reliable delivery</p>
      </div>

      <div class="hero-brand">
        <img src="logo.png" alt="Totes Ma'Goats logo" />
        <div class="quote">“Save the trees. Move with ease!”<br />— Ma'Goats</div>
      </div>
    </div>
  </section>

  <div class="brand-strip">Save the trees. Move with ease!</div>

  <section class="section">
    <div class="container">
      <h2>How It Works</h2>
      <p class="section-intro">Designed for busy renters and elevator-served buildings who want a cleaner, easier, more organized move inside the Downtown Seattle and Downtown Bellevue corridor.</p>

      <div class="cards">
        <div class="card">
          <h3>1. Reserve</h3>
          <p>Choose your move size, enter your move details, and secure your reservation online.</p>
        </div>

        <div class="card">
          <h3>2. Pack</h3>
          <p>Use durable totes that stack neatly, protect your items, and simplify move day.</p>
        </div>

        <div class="card">
          <h3>3. Return</h3>
          <p>When the move is complete, we collect them. No cardboard pile. No cleanup required.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <h2>How Many Totes Do I Need?</h2>
      <p class="section-intro">
        Each package includes a fixed number of totes. The suggested range below is there to help you decide whether you may want to request additional add-on totes depending on how much you need to pack.
      </p>

      <div class="guide-list">
        <div class="guide-row guide-head">
          <div>Package</div>
          <div>Included</div>
          <div>Price</div>
          <div>Suggested Range</div>
        </div>

        <div class="guide-row">
          <div class="guide-left">Studio / Small 1 Bedroom</div>
          <div class="guide-muted">20 totes</div>
          <div class="guide-price">$99</div>
          <div class="guide-muted">20–25 totes*</div>
        </div>

        <div class="guide-row">
          <div class="guide-left">Standard 1 Bedroom</div>
          <div class="guide-muted">30 totes</div>
          <div class="guide-price">$149</div>
          <div class="guide-muted">25–35 totes*</div>
        </div>

        <div class="guide-row">
          <div class="guide-left">2 Bedroom</div>
          <div class="guide-muted">40 totes</div>
          <div class="guide-price">$199</div>
          <div class="guide-muted">35–45 totes*</div>
        </div>

        <div class="guide-row">
          <div class="guide-left">3 Bedroom</div>
          <div class="guide-muted">50 totes</div>
          <div class="guide-price">$249</div>
          <div class="guide-muted">45–60 totes*</div>
        </div>

        <div class="guide-row">
          <div class="guide-left">Large Homes</div>
          <div class="guide-muted">75 totes</div>
          <div class="guide-price">$300</div>
          <div class="guide-muted">60+ totes*</div>
        </div>
      </div>

      <p class="micro-note">
        *Suggested ranges are estimates only and may vary depending on how much you need to pack. Single totes are available only as add-ons after selecting one of the packages above.
      </p>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <h2>Why Totes Ma'Goats?</h2>

      <div class="cards">
        <div class="card">
          <h3>Eco-Friendly</h3>
          <p>No cardboard waste. Reusable totes make moving cleaner, greener, and smarter.</p>
        </div>

        <div class="card">
          <h3>Stronger</h3>
          <p>Commercial-grade totes hold up better than flimsy boxes and stack beautifully for elevator-friendly moves.</p>
        </div>

        <div class="card">
          <h3>Convenient</h3>
          <p>Delivered and collected within a focused service corridor — ideal for busy professionals and urban moves.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Elevator-Friendly Service</h2>
      <p class="section-intro">
        Built for modern apartment living, mid-rise communities, and elevator-managed moves in Downtown Seattle and Downtown Bellevue.
      </p>

      <div class="cards">
        <div class="card">
          <h3>Concierge-Aware Delivery</h3>
          <p>We understand that many buildings require front desk coordination, entry procedures, or specific delivery instructions.</p>
        </div>

        <div class="card">
          <h3>Loading Dock Ready</h3>
          <p>If your building has a loading dock or service entrance, include those details at booking so delivery goes smoothly and on time.</p>
        </div>

        <div class="card">
          <h3>Elevator Reservation Friendly</h3>
          <p>Need us to work around a reserved freight elevator or move-in window? Add that information in your booking notes and we’ll plan accordingly.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Primary Delivery Corridor</h2>

      <div class="service-pills">
        <div class="pill">Downtown Seattle</div>
        <div class="pill">Downtown Bellevue</div>
      </div>

      <p class="section-intro" style="margin-top:28px;">
        We currently serve Downtown Seattle and Downtown Bellevue exclusively. This focused service area allows us to provide faster delivery, tighter scheduling, and a more reliable, high-touch experience for residents in these buildings.
      </p>
    </div>
  </section>

  <section class="section alt" id="booking">
    <div class="container">
      <h2>Reserve Your Move Date</h2>
      <p class="section-intro">
        Choose your package, tell us about your move, and continue to secure your booking.
      </p>

      <div class="booking-wrap">
        <div class="booking-grid">
          <div class="booking-form">
            <div class="booking-label">Booking Request</div>
            <h3>Booking Details</h3>

            <div class="package-helper">
              Start by selecting your base package below. Single totes are available only as add-ons after you choose one of the main move packages.
            </div>

            <form id="bookingForm" action="https://formspree.io/f/xgonrwvr" method="POST">
              <div class="form-row">
                <div class="form-group">
                  <label for="fullName">Full Name</label>
                  <input type="text" id="fullName" name="full_name" required />
                </div>

                <div class="form-group">
                  <label for="phone">Phone Number</label>
                  <input type="tel" id="phone" name="phone" required />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="email">Email Address</label>
                  <input type="email" id="email" name="email" required />
                </div>

                <div class="form-group">
                  <label for="moveDate">Move Date</label>
                  <input type="date" id="moveDate" name="move_date" required />
                </div>
              </div>

              <div class="address-block">
                <div class="address-title">Moving From</div>

                <div class="form-group">
                  <label for="fromStreet">Street Address</label>
                  <input type="text" id="fromStreet" name="from_street" required />
                </div>

                <div class="form-group">
                  <label for="fromUnit">Apt / Unit</label>
                  <input type="text" id="fromUnit" name="from_unit" />
                </div>

                <div class="form-row three">
                  <div class="form-group">
                    <label for="fromCity">City</label>
                    <select id="fromCity" name="from_city" required>
                      <option value="">Select city</option>
                      <option>Seattle</option>
                      <option>Bellevue</option>
                    </select>
                  </div>

                  <div class="form-group">
                    <label for="fromState">State</label>
                    <input type="text" id="fromState" name="from_state" value="WA" readonly />
                  </div>

                  <div class="form-group">
                    <label for="fromZip">ZIP Code</label>
                    <input type="text" id="fromZip" name="from_zip" inputmode="numeric" maxlength="5" required />
                  </div>
                </div>
              </div>

              <div class="address-block">
                <div class="address-title">Moving To</div>

                <div class="form-group">
                  <label for="toStreet">Street Address</label>
                  <input type="text" id="toStreet" name="to_street" required />
                </div>

                <div class="form-group">
                  <label for="toUnit">Apt / Unit</label>
                  <input type="text" id="toUnit" name="to_unit" />
                </div>

                <div class="form-row three">
                  <div class="form-group">
                    <label for="toCity">City</label>
                    <select id="toCity" name="to_city" required>
                      <option value="">Select city</option>
                      <option>Seattle</option>
                      <option>Bellevue</option>
                    </select>
                  </div>

                  <div class="form-group">
                    <label for="toState">State</label>
                    <input type="text" id="toState" name="to_state" value="WA" readonly />
                  </div>

                  <div class="form-group">
                    <label for="toZip">ZIP Code</label>
                    <input type="text" id="toZip" name="to_zip" inputmode="numeric" maxlength="5" required />
                  </div>
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="deliveryCity">Service Corridor</label>
                  <select id="deliveryCity" name="delivery_city" required>
                    <option value="">Select service corridor</option>
                    <option>Downtown Seattle</option>
